{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ledgerly-money-api.onrender.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://ledgerly-money-api.onrender.com/healthz"
    },
    {
      "source": "/:path((?!api/|healthz|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
